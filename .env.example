# Service Configuration
SERVICE_NAME=a2a-calendar-agent
AGENT_ID=google_calendar_agent
AGENT_NAME=Google Calendar Agent

# Server Configuration
HOST=localhost
PORT=10004
APP_URL=http://localhost:10004

# Environment
ENV=local
DEBUG=true
LOG_LEVEL=INFO
DISABLE_LOG=false
AUTO_AUTH_MODE=true

# LLM API Keys (at least one is required)
OPENAI_API_KEY=
GROQ_API_KEY=

# Google Calendar API Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
JWT_SECRET=super-secret-jwt-key
SESSION_EXPIRY_SECONDS=2592000

# Remote Agents
REMOTE_AGENT_ADDRESSES=http://localhost:10001
DATETIME_PARSER_AGENT=Datetime Parser Agent
